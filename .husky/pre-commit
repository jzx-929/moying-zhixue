# Pre-commit 检查
echo "正在执行 pre-commit 检查..."

# 检查是否有调试代码残留
DEBUG_PATTERNS="console\.log\|print(\|debugger\|pdb\.set_trace"
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py|js|ts|jsx|tsx|vue)$' | grep -v '^scripts/' || true)

if [ -n "$STAGED_FILES" ]; then
  if echo "$STAGED_FILES" | xargs grep -nE "$DEBUG_PATTERNS" 2>/dev/null; then
    echo ""
    echo "警告: 检测到调试代码，请确认是否需要移除后重新提交"
    echo "如确需保留，可使用 git commit --no-verify 跳过检查"
    exit 1
  fi
fi

echo "pre-commit 检查通过"
